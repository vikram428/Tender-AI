rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Documents & Scoped Nested Tenders: Strictly Private to Owner
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // Scoped user tenders structure
      match /tenders/{documentId} {
        allow read, write: if isOwner(userId);

        match /chunks/{chunkId} {
          allow read, write: if isOwner(userId);
        }

        match /conversations/{conversationId} {
          allow read, write: if isOwner(userId);

          match /messages/{messageId} {
            allow read, write: if isOwner(userId);
          }
        }
      }
    }

    // Primary Tender Documents Collection: Isolated by Owner UID
    match /tenders/{tenderId} {
      // Document Read: Owner can get document
      allow get: if isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);

      // Query Read: Only documents matching query ownerUid == request.auth.uid
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Document Deletion: Only owner can delete
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Document Creation: Must be signed in, ownerUid must equal auth.uid
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Document Update: Owner must match, ownerUid cannot be changed
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // Chat Messages Subcollection for Private Conversation History
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      // Chunks Subcollection for RAG Embeddings & Extracted Text
      match /chunks/{chunkId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
