rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Documents: Strictly Private to Owner
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Tender Documents: Isolated by Owner UID
    match /tenders/{tenderId} {
      // Document Read
      allow get: if isSignedIn() && isValidId(tenderId) && existing().ownerUid == request.auth.uid;

      // Query Read: Only documents matching the query ownerUid == request.auth.uid
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Document Deletion: Only owner can delete
      allow delete: if isSignedIn() && isValidId(tenderId) && existing().ownerUid == request.auth.uid;

      // Document Creation: Must be signed in, ownerUid must equal auth.uid, and have basic required fields
      allow create: if isSignedIn()
        && isValidId(tenderId)
        && incoming().ownerUid == request.auth.uid
        && incoming().nitNumber is string
        && incoming().title is string
        && incoming().estimatedCost is number;

      // Document Update: Owner must match, ownerUid cannot be changed
      allow update: if isSignedIn()
        && isValidId(tenderId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid;

      // Chat Messages Subcollection for Private Conversation History
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && isValidId(tenderId) && isValidId(messageId)
          && get(/databases/$(database)/documents/tenders/$(tenderId)).data.ownerUid == request.auth.uid;
      }

      // Chunks Subcollection for RAG Embeddings & Extracted Text
      match /chunks/{chunkId} {
        allow read, write: if isSignedIn() && isValidId(tenderId) && isValidId(chunkId)
          && get(/databases/$(database)/documents/tenders/$(tenderId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
